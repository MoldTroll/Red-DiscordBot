msgstr "{title} (계속)"

#: redbot/core/commands/help.py:779
msgid "Help topic for {command_name} not found."
msgstr "{command_name}에 대한 도움말을 찾을 수 없어요."

#: redbot/core/commands/help.py:798
msgid "Command {command_name} has no subcommand named {not_found}."
msgstr "{command_name} 명령어에는 {not_found} 하위 명령어가 없어요."

#: redbot/core/commands/help.py:903
msgid "I couldn't send the help message to you in DM. Either you blocked me or you disabled DMs in this server."
msgstr "DM으로 도움말을 보내지 못했어요. 봇을 차단했거나 이 서버의 DM을 껐는지 확인해 주세요."

#: redbot/core/commands/help.py:914
msgid "I have sent the help message to your DMs."
msgstr "도움말을 DM으로 보냈어요."

#: redbot/core/commands/help.py:939
