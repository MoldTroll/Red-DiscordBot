"{names}"
msgstr "{cog_names}의 명령어 {count}개를 활성화했습니다.\n"
"{names}"

#: redbot/core/core_commands.py:2196
msgid "Couldn't find any disabled commands from {cog_names}. Use `{prefix}slash list` to see all cogs with application commands."
