msgid "Lavalink Node Settings"
msgstr "Lavalink 노드 설정"

#: redbot/cogs/audio/core/commands/llset.py:342
msgid "Initial Heapsize: [{xms}]\n"
msgstr "초기 힙 크기:     [{xms}]\n"

#: redbot/cogs/audio/core/commands/llset.py:343
