#: redbot/cogs/admin/admin.py:20
msgid "I attempted to do something that Discord denied me permissions for. Your command failed to successfully complete."
msgstr "봇에 필요한 Discord 권한이 없어 명령을 완료하지 못했어요."

#: redbot/cogs/admin/admin.py:25
msgid "I can not give {role.name} to {member.display_name} because that role is higher than or equal to my highest role in the Discord hierarchy."
msgstr "{role.name} 역할이 봇의 최고 역할과 같거나 더 높아서 {member.display_name}님에게 부여할 수 없어요."

#: redbot/cogs/admin/admin.py:31
msgid "I can not remove {role.name} from {member.display_name} because that role is higher than or equal to my highest role in the Discord hierarchy."
msgstr "{role.name} 역할이 봇의 최고 역할과 같거나 더 높아서 {member.display_name}님에게서 회수할 수 없어요."

#: redbot/cogs/admin/admin.py:37
msgid "I can not edit {role.name} because that role is higher than my or equal to highest role in the Discord hierarchy."
msgstr "{role.name} 역할이 봇의 최고 역할과 같거나 더 높아서 수정할 수 없어요."

#: redbot/cogs/admin/admin.py:43
msgid "I can not let you give {role.name} to {member.display_name} because that role is higher than or equal to your highest role in the Discord hierarchy."
msgstr "{role.name} 역할이 명령을 실행한 분의 최고 역할과 같거나 더 높아서 {member.display_name}님에게 부여할 수 없어요."

#: redbot/cogs/admin/admin.py:49
msgid "I can not let you remove {role.name} from {member.display_name} because that role is higher than or equal to your highest role in the Discord hierarchy."
msgstr "{role.name} 역할이 명령을 실행한 분의 최고 역할과 같거나 더 높아서 {member.display_name}님에게서 회수할 수 없어요."

#: redbot/cogs/admin/admin.py:55
msgid "I can not let you edit {role.name} because that role is higher than or equal to your highest role in the Discord hierarchy."
msgstr "{role.name} 역할이 명령을 실행한 분의 최고 역할과 같거나 더 높아서 수정할 수 없어요."

#: redbot/cogs/admin/admin.py:61
msgid "I need the \"Manage Roles\" permission to do that."
msgstr "이 작업을 수행하려면 \"역할 관리\" 권한이 필요해요."

#: redbot/cogs/admin/admin.py:63
msgid "I am already announcing something. If you would like to make a different announcement please use `{prefix}announce cancel` first."
msgstr "이미 공지를 보내고 있어요. 다른 공지를 보내려면 먼저 `{prefix}announce cancel`을 사용해 주세요."

#: redbot/cogs/admin/admin.py:73
#, docstring
msgid "A collection of server administration utilities."
msgstr "서버 관리를 위한 기능 모음"

#: redbot/cogs/admin/admin.py:159
msgid "{member.display_name} already has the role {role.name}."
msgstr "{member.display_name}님은 이미 {role.name} 역할을 가지고 있어요."

#: redbot/cogs/admin/admin.py:180
msgid "I successfully added {role.name} to {member.display_name}"
msgstr "{member.display_name}님에게 {role.name} 역할을 부여했어요."

#: redbot/cogs/admin/admin.py:190
msgid "{member.display_name} does not have the role {role.name}."
msgstr "{member.display_name}님은 {role.name} 역할을 가지고 있지 않아요."

#: redbot/cogs/admin/admin.py:211
msgid "I successfully removed {role.name} from {member.display_name}"
msgstr "{member.display_name}님에게서 {role.name} 역할을 회수했어요."

#: redbot/cogs/admin/admin.py:226
#, docstring
msgid "\n"
"        Add a role to a user.\n\n"
"        Use double quotes if the role contains spaces.\n"
"        If user is left blank it defaults to the author of the command.\n"
"        "
msgstr "\n"
"사용자에게 역할을 부여합니다.\n"
"\n"
"역할 이름에 공백이 있으면 큰따옴표로 묶어 주세요. 사용자를 생략하면 명령을 실행한 사람에게 역할을 부여합니다.\n"
"        "

#: redbot/cogs/admin/admin.py:244
#, docstring
msgid "\n"
"        Remove a role from a user.\n\n"
"        Use double quotes if the role contains spaces.\n"
"        If user is left blank it defaults to the author of the command.\n"
"        "
msgstr "\n"
"사용자에게서 역할을 회수합니다.\n"
"\n"
"역할 이름에 공백이 있으면 큰따옴표로 묶어 주세요. 사용자를 생략하면 명령을 실행한 사람에게서 역할을 회수합니다.\n"
"        "

#: redbot/cogs/admin/admin.py:256
#, docstring
msgid "Edit role settings."
msgstr "역할 설정을 변경합니다."

#: redbot/cogs/admin/admin.py:263
#, docstring
msgid "\n"
"        Edit a role's colour.\n\n"
"        Use double quotes if the role contains spaces.\n"
"        Colour must be in hexadecimal format.\n"
"        [Online colour picker](http://www.w3schools.com/colors/colors_picker.asp)\n\n"
"        Examples:\n"
"            `[p]editrole colour \"The Transistor\" #ff0000`\n"
"            `[p]editrole colour Test #ff9900`\n"
"        "
msgstr "\n"
"역할 색상을 변경합니다.\n"
"\n"
"역할 이름에 공백이 있으면 큰따옴표로 묶어 주세요. 색상은 16진수로 입력합니다.\n"
"[온라인 색상 선택기](http://www.w3schools.com/colors/colors_picker.asp)\n"
"\n"
"예시:\n"
"    `[p]editrole colour \"The Transistor\" #ff0000`\n"
"    `[p]editrole colour Test #ff9900`\n"
"        "

#: redbot/cogs/admin/admin.py:275
msgid "{author} ({author.id}) changed the colour of role '{role.name}'"
msgstr "{author}({author.id})님이 '{role.name}' 역할의 색상을 변경함"

#: redbot/cogs/admin/admin.py:294 redbot/cogs/admin/admin.py:327
msgid "Done."
msgstr "완료했어요."

#: redbot/cogs/admin/admin.py:298
#, docstring
msgid "\n"
"        Edit a role's name.\n\n"
"        Use double quotes if the role or the name contain spaces.\n\n"
"        Example:\n"
"            `[p]editrole name \"The Transistor\" Test`\n"
"        "
msgstr "\n"
"        역할 이름을 변경합니다.\n\n"
"        현재 이름이나 새 이름에 공백이 있으면 큰따옴표로 묶으세요.\n\n"
"        예시:\n"
"            `[p]editrole name \"The Transistor\" Test`\n"
"        "

#: redbot/cogs/admin/admin.py:308
msgid "{author} ({author.id}) changed the name of role '{old_name}' to '{name}'"
msgstr "{author}({author.id})님이 역할 이름을 '{old_name}'에서 '{name}'으로 변경함"

#: redbot/cogs/admin/admin.py:332
#, docstring
msgid "Announce a message to all servers the bot is in."
msgstr "봇이 있는 모든 서버에 메시지를 알립니다."

#: redbot/cogs/admin/admin.py:339
msgid "The announcement has begun."
msgstr "공지를 보내기 시작했어요."

#: redbot/cogs/admin/admin.py:346
#, docstring
msgid "Cancel a running announce."
msgstr "전송 중인 공지를 취소합니다."

#: redbot/cogs/admin/admin.py:348
msgid "There is no currently running announcement."
msgstr "현재 진행 중인 공지사항이 없습니다."

#: redbot/cogs/admin/admin.py:351
msgid "The current announcement has been cancelled."
msgstr "전송 중이던 공지를 취소했어요."

#: redbot/cogs/admin/admin.py:357
#, docstring
msgid "Change how announcements are sent in this guild."
msgstr "이 서버의 공지 전송 방식을 변경합니다."

#: redbot/cogs/admin/admin.py:367
#, docstring
msgid "Change the channel where the bot will send announcements."
msgstr "봇이 공지를 보낼 채널을 변경합니다."

#: redbot/cogs/admin/admin.py:370
msgid "The announcement channel has been set to {channel.mention}"
msgstr "공지 채널을 {channel.mention}(으)로 설정했어요."

#: redbot/cogs/admin/admin.py:375
#, docstring
msgid "Unsets the channel for announcements."
msgstr "공지사항에 대한 채널 설정을 해제합니다."

#: redbot/cogs/admin/admin.py:400
#, docstring
msgid "\n"
"        Add or remove a selfrole from yourself.\n\n"
"        Server admins must have configured the role as user settable.\n"
"        NOTE: The role is case sensitive!\n"
"        "
msgstr "\n"
"원하는 역할을 직접 추가하거나 해제합니다.\n"
"\n"
"서버 관리자가 멤버에게 선택을 허용한 역할만 사용할 수 있습니다. 역할 이름은 대소문자를 구분합니다.\n"
"        "

#: redbot/cogs/admin/admin.py:413
#, docstring
msgid "\n"
"        Add a selfrole to yourself.\n\n"
"        Server admins must have configured the role as user settable.\n"
"        NOTE: The role is case sensitive!\n"
"        "
msgstr "\n"
"원하는 역할을 직접 추가합니다.\n"
"\n"
"서버 관리자가 멤버에게 선택을 허용한 역할만 사용할 수 있습니다. 역할 이름은 대소문자를 구분합니다.\n"
"        "

#: redbot/cogs/admin/admin.py:424
#, docstring
msgid "\n"
"        Remove a selfrole from yourself.\n\n"
"        Server admins must have configured the role as user settable.\n"
"        NOTE: The role is case sensitive!\n"
"        "
msgstr "\n"
"직접 선택한 역할을 해제합니다.\n"
"\n"
"서버 관리자가 멤버에게 선택을 허용한 역할만 사용할 수 있습니다. 역할 이름은 대소문자를 구분합니다.\n"
"        "

#: redbot/cogs/admin/admin.py:435
#, docstring
msgid "\n"
"        Lists all available selfroles.\n"
"        "
msgstr "\n"
"멤버가 직접 선택할 수 있는 역할을 모두 표시합니다.\n"
"        "

#: redbot/cogs/admin/admin.py:445
msgid "Available Selfroles:\n"
"{selfroles}"
msgstr "직접 선택할 수 있는 역할:\n"
"{selfroles}"

#: redbot/cogs/admin/admin.py:451
#, docstring
msgid "Manage selfroles."
msgstr "멤버가 직접 선택할 수 있는 역할을 관리합니다."

#: redbot/cogs/admin/admin.py:456
#, docstring
msgid "\n"
"        Add a role, or a selection of roles, to the list of available selfroles.\n\n"
"        NOTE: The role is case sensitive!\n"
"        "
msgstr "\n"
"멤버가 직접 선택할 수 있는 역할 목록에 역할을 하나 이상 추가합니다.\n"
"\n"
"역할 이름은 대소문자를 구분합니다.\n"
"        "

#: redbot/cogs/admin/admin.py:465
msgid "I cannot let you add {role.name} as a selfrole because that role is higher than or equal to your highest role in the Discord hierarchy."
msgstr "{role.name} 역할이 명령을 실행한 분의 최고 역할과 같거나 더 높아서 선택 가능한 역할로 등록할 수 없어요."

#: redbot/cogs/admin/admin.py:475
msgid "The role \"{role.name}\" is already a selfrole."
msgstr "\"{role.name}\" 역할은 이미 선택 가능한 역할로 등록되어 있어요."

#: redbot/cogs/admin/admin.py:481
msgid "Added {count} selfroles."
msgstr "선택 가능한 역할 {count}개를 추가했어요."

#: redbot/cogs/admin/admin.py:483
msgid "Added 1 selfrole."
msgstr "선택 가능한 역할 1개를 추가했어요."

#: redbot/cogs/admin/admin.py:489
#, docstring
msgid "\n"
"        Remove a role, or a selection of roles, from the list of available selfroles.\n\n"
"        NOTE: The role is case sensitive!\n"
"        "
msgstr "\n"
"멤버가 직접 선택할 수 있는 역할 목록에서 역할을 하나 이상 제거합니다.\n"
"\n"
"역할 이름은 대소문자를 구분합니다.\n"
"        "

#: redbot/cogs/admin/admin.py:498
msgid "I cannot let you remove {role.name} from being a selfrole because that role is higher than or equal to your highest role in the Discord hierarchy."
msgstr "{role.name} 역할이 명령을 실행한 분의 최고 역할과 같거나 더 높아서 선택 가능한 역할 목록에서 제거할 수 없어요."

#: redbot/cogs/admin/admin.py:508
msgid "Removed {count} selfroles."
msgstr "선택 가능한 역할 {count}개를 목록에서 제거했어요."

#: redbot/cogs/admin/admin.py:510
msgid "Removed 1 selfrole."
msgstr "선택 가능한 역할 1개를 목록에서 제거했어요."

#: redbot/cogs/admin/admin.py:516
#, docstring
msgid "Clear the list of available selfroles for this server."
msgstr "이 서버에서 멤버가 직접 선택할 수 있는 역할 목록을 비웁니다."

#: redbot/cogs/admin/admin.py:520
msgid "There are currently no selfroles."
msgstr "현재 직접 선택할 수 있는 역할이 없어요."

#: redbot/cogs/admin/admin.py:523
msgid "Are you sure you want to clear this server's selfrole list?"
msgstr "이 서버에서 직접 선택할 수 있는 역할 목록을 비울까요?"

#: redbot/cogs/admin/admin.py:529
msgid "You took too long to respond."
msgstr "응답 시간이 지났어요."

#: redbot/cogs/admin/admin.py:538
msgid "I cannot clear the selfroles because the selfrole '{role.name}' is higher than or equal to your highest role in the Discord hierarchy."
msgstr "'{role.name}' 역할이 명령을 실행한 분의 최고 역할과 같거나 더 높아서 선택 가능한 역할 목록을 비울 수 없어요."

#: redbot/cogs/admin/admin.py:544
msgid "Selfrole list cleared."
msgstr "선택 가능한 역할 목록을 비웠어요."

#: redbot/cogs/admin/admin.py:546
msgid "No changes have been made."
msgstr "변경 사항이 없어요."

#: redbot/cogs/admin/admin.py:551
#, docstring
msgid "Lock a bot to its current servers only."
msgstr "봇이 현재 참여 중인 서버에서만 활동하도록 제한합니다."

#: redbot/cogs/admin/admin.py:556
msgid "The bot is no longer serverlocked."
msgstr "이제 봇이 새 서버에 참여할 수 있어요."

#: redbot/cogs/admin/admin.py:558
msgid "The bot is now serverlocked."
msgstr "이제 봇이 새 서버에 참여할 수 없어요."

#: redbot/cogs/admin/announcer.py:68
msgid "I could not announce to the following server: "
msgstr "다음 서버에 공지를 보내지 못했어요: "

#: redbot/cogs/admin/announcer.py:70
msgid "I could not announce to the following servers: "
msgstr "다음 서버에 공지를 보내지 못했어요: "

#: redbot/cogs/admin/converters.py:13
msgid "The Admin cog is not loaded."
msgstr "Admin 모듈이 로드되지 않았어요."

#: redbot/cogs/admin/converters.py:30
msgid "The role \"{role_name}\" is not a valid selfrole."
msgstr "\"{role_name}\" 역할은 직접 선택할 수 있는 역할이 아니에요."

#: redbot/cogs/admin/converters.py:36
msgid "This selfrole has more than one case insensitive match. Please ask a moderator to resolve the ambiguity, or use the role ID to reference the role."
msgstr "대소문자를 구분하지 않으면 이 이름과 일치하는 역할이 여러 개예요. 운영진에게 이름을 구분해 달라고 요청하거나 역할 ID를 입력해 주세요."

