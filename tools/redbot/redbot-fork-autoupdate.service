[Unit]
Description=Check the Red music bot fork and update idle instances in order
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/default/redbot-fork-update
StateDirectory=redbot-fork-update
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/python3 -I /usr/local/libexec/redbot-fork/update.py --automatic
TimeoutStartSec=45min
